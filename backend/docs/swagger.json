{
  "openapi": "3.0.0",
  "info": {
    "title": "HealthLink API Documentation",
    "version": "1.0.0",
    "description": "Documentation for the HealthLink backend services."
  },
  "servers": [
    {
      "url": "http://localhost:5000",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "summary": "User Login",
        "responses": {
          "200": { "description": "Login successful" },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/api/users": {
      "get": {
        "summary": "Get all users",
        "responses": {
          "200": { "description": "Success" }
        }
      }
    }
  }
}
